# ── OAuth credentials & tokens — NEVER commit these ──────────────────────────
script/client_secret.json
script/token.json

# ── Runtime state (per-user, per-machine) ────────────────────────────────────
script/.quota.json
script/.watcher.pid
script/.watcher.log
script/background.json

# ── Generated files in reciter folders ───────────────────────────────────────
*.mp4
*.uploaded

# ── Reciter audio folders ────────────────────────────────────────────────────
# These are user data, not code. Don't commit anything outside /script.
# (Uncomment the next two lines if you want to lock this down strictly.)
# /*
# !/script/
# !/README.md
# !/LICENSE
# !/.gitignore

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
build/
dist/
.venv/
venv/

# ── OS junk ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editors / IDEs ───────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
