{
  "_comment": "Every style knob at its default (= the locked design). Pass any subset under `style` in a job; omit what you don't change. Colours: #RGB, #RRGGBB, #RRGGBBAA, rgb(), rgba(). Ranges in README.md / style.ts.",

  "photo": {
    "focusX": 50,
    "focusY": 50,
    "zoom": 1,
    "blur": 0,
    "brightness": 1,
    "contrast": 1,
    "saturation": 1,
    "hue": 0,
    "sepia": 0,
    "grain": 0
  },

  "overlay": {
    "color": "#0B1A26",
    "top": 0.22,
    "middle": 0.46,
    "bottom": 0.84,
    "angle": 180,
    "vignetteStrength": 1,
    "vignetteSize": 100,
    "scrimStrength": 1,
    "scrimSize": 60
  },

  "text": {
    "offsetX": 0,
    "offsetY": -30,
    "width": 0.8125,
    "gapAboveTitle": 10,
    "gapBelowTitle": 24
  },

  "shadow": {
    "color": "#000000",
    "opacity": 0.55,
    "blur": 12,
    "offsetY": 2
  },

  "title": {
    "color": "#D6B33C",
    "gradient": 1,
    "gradientAngle": 180,
    "scale": 1,
    "opacity": 1,
    "glow": 1,
    "glowColor": "#EBD27A",
    "glowSize": 22,
    "outlineWidth": 0,
    "outlineColor": "#000000",
    "surahWordScale": 1,
    "surahWordGap": 0.14,
    "joinScale": 0.38
  },

  "reciter": {
    "color": "#F4EFE3",
    "scale": 1,
    "opacity": 1,
    "letterSpacing": 0,
    "pill": { "opacity": 0, "color": "#0B1A26", "radius": 16, "paddingX": 24, "paddingY": 8 }
  },

  "meta": {
    "color": "#F4EFE3",
    "scale": 1,
    "opacity": 0.82,
    "prayerOpacity": 1,
    "dateOpacity": 1,
    "letterSpacing": 0,
    "gap": 0.55,
    "separatorColor": "#EBD27A",
    "separatorSize": 7,
    "pill": { "opacity": 0, "color": "#0B1A26", "radius": 16, "paddingX": 24, "paddingY": 8 }
  },

  "dividers": {
    "aboveTitle": { "opacity": 0, "width": 120, "thickness": 3, "color": "#EBD27A" },
    "belowTitle": { "opacity": 0, "width": 120, "thickness": 3, "color": "#EBD27A" }
  },

  "frame": {
    "width": 0,
    "color": "#EBD27A",
    "opacity": 1,
    "inset": 24,
    "radius": 0
  },

  "output": {
    "quality": 90
  }
}
